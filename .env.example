# Art of Balance - NEX server config.
# Copy to .env and fill in. All names are namespaced PN_ARTOFBALANCE_*.

# --- PRUDP listeners ---
PN_ARTOFBALANCE_AUTH_PORT=26500
PN_ARTOFBALANCE_SECURE_PORT=26501
# Host the client is told to reach the secure server on. MUST be short: the
# retail binary truncates it into a ~15-char buffer. Use a bare LAN IP or
# hostname the console can dial, not a subdomain.
PN_ARTOFBALANCE_SECURE_HOST=localhost

# --- Database (ranking + matchmaking + tracking, one database) ---
PN_ARTOFBALANCE_POSTGRES_URI=postgres://artofbalance:artofbalance@localhost:5432/artofbalance?sslmode=disable

# --- Kerberos / system accounts ---
PN_ARTOFBALANCE_KERBEROS_PASSWORD=change-me

# --- Auth mode --------------------------------------------------------------
# 1 = isolated preservation mode: accounts from settings.json, login token
#     not validated. Leave the two NEX_* vars below empty. Use only on an
#     isolated network.
PN_ARTOFBALANCE_LOCAL_MODE=1
PN_ARTOFBALANCE_SETTINGS_PATH=settings.json

# Required only when PN_ARTOFBALANCE_LOCAL_MODE is not 1 (shared deployment
# behind a Pretendo-style account server):
#   PN_ARTOFBALANCE_NEX_TOKEN_AES_KEY   64 hex chars (AES-256), matches the account server
#   PN_ARTOFBALANCE_NEX_PASSWORD_SECRET >=32 bytes hex, matches the account server
PN_ARTOFBALANCE_NEX_TOKEN_AES_KEY=
PN_ARTOFBALANCE_NEX_PASSWORD_SECRET=
